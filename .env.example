# EXPO_PUBLIC_API_URL: base URL for the what-watch API.
# emulator-5554 (Android emulator): http://10.0.2.2:3000
# physical device on the LAN:       http://192.168.1.30:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# EXPO_PUBLIC_UPDATE_MANIFEST_URL: the OTA update manifest.
# Unset in dev, the checker stays off. For the emulator e2e, serve
# update-manifest.json locally and point here, e.g. http://10.0.2.2:8123/update-manifest.json
# EXPO_PUBLIC_UPDATE_MANIFEST_URL=https://github.com/<owner>/<repo>/releases/download/latest/update-manifest.json

# EXPO_PUBLIC_UPDATE_CHANNEL: which manifest entry this build follows.
# stable (default) or beta.
# EXPO_PUBLIC_UPDATE_CHANNEL=stable
