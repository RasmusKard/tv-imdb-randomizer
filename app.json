{
  "expo": {
    "icon": "./assets/images/icon-1024x1024.png",
    "plugins": [
      "./plugins/esc-to-back",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/images/icon-400x240.png",
          "appleTVImages": {
            "icon": "./assets/images/icon-1280x768.png",
            "iconSmall": "./assets/images/icon-400x240.png",
            "iconSmall2x": "./assets/images/icon-800x480.png",
            "topShelf": "./assets/images/icon-1920x720.png",
            "topShelf2x": "./assets/images/icon-3840x1440.png",
            "topShelfWide": "./assets/images/icon-2320x720.png",
            "topShelfWide2x": "./assets/images/icon-4640x1440.png"
          }
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.delfiapp.tvimdbrandomizer",
      "permissions": ["REQUEST_INSTALL_PACKAGES"]
    },
    "ios": {
      "bundleIdentifier": "com.delfiapp.tvimdbrandomizer",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lets your phone open the CSV upload page hosted on this Apple TV, so your IMDb list can be imported."
      }
    },
    "name": "tv-imdb-randomizer",
    "slug": "tv-imdb-randomizer"
  }
}
